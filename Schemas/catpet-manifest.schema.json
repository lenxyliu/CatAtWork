{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://catatwork.app/schemas/catpet-manifest-v1.json",
  "title": "CatAtWork Pet Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "displayName", "author", "description", "minimumAppVersion", "pixelsPerBodyUnit", "animations", "lookDirections"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "minimumAppVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$" },
    "assetVersion": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
    "pixelsPerBodyUnit": { "type": "number", "exclusiveMinimum": 0 },
    "animations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/animation" }
    },
    "lookDirections": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["degrees", "frame"],
        "properties": {
          "degrees": { "type": "number", "minimum": 0, "maximum": 337.5, "multipleOf": 22.5 },
          "frame": { "$ref": "#/$defs/frame" }
        }
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "pixelPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "sourceSize", "trimRect", "pivot", "duration"],
      "properties": {
        "image": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
        "sourceSize": { "$ref": "#/$defs/size" },
        "trimRect": { "$ref": "#/$defs/rect" },
        "textureRect": { "anyOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
        "collisionRect": { "anyOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
        "pivot": { "$ref": "#/$defs/point" },
        "renderOffset": { "anyOf": [{ "$ref": "#/$defs/pixelPoint" }, { "type": "null" }] },
        "duration": { "type": "number", "minimum": 0.0083333333, "maximum": 1 },
        "bodyScale": { "type": ["number", "null"], "minimum": 0.5, "maximum": 3.0 }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "loopMode", "frames"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "loopMode": { "enum": ["loop", "once", "pingPong"] },
        "nextAnimation": { "type": ["string", "null"] },
        "startPose": { "type": ["string", "null"], "maxLength": 40 },
        "endPose": { "type": ["string", "null"], "maxLength": 40 },
        "loopStartFrame": { "type": ["integer", "null"], "minimum": 0 },
        "frames": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/frame" } }
      }
    }
  }
}
